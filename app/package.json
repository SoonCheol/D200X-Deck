{
  "name": "ulanzi-deck-open",
  "productName": "Ulanzi Deck Open",
  "version": "0.1.0",
  "description": "Open-source control for Ulanzi D200 decks",
  "main": "main.js",
  "type": "commonjs",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "package": "electron-packager . 'Ulanzi Deck Open' --platform=darwin --arch=arm64 --out=dist --overwrite --icon=build/icon --app-bundle-id=com.edufalcao.ulanzideckopen --app-version=0.1.0 --prune=true --ignore='^/(dist|build/icon\\.iconset)'",
    "package:all": "electron-packager . 'Ulanzi Deck Open' --platform=darwin --arch=universal --out=dist --overwrite --icon=build/icon --app-bundle-id=com.edufalcao.ulanzideckopen --app-version=0.1.0 --prune=true --ignore='^/(dist|build/icon\\.iconset)'",
    "postpackage": "find dist -name electron.icns -exec cp build/icon.icns {} \\;"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.1.0"
  }
}
