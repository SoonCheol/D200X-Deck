{
  "name": "ulanzi-deck-open",
  "productName": "Ulanzi Deck Open",
  "version": "0.1.0",
  "description": "Open-source control for Ulanzi D200 decks",
  "main": "main.js",
  "type": "commonjs",
  "author": "",
  "license": "MIT",
  "scripts": {
    "build:native": "sh scripts/build-hidseize.sh",
    "prepackage": "sh scripts/build-hidseize.sh",
    "start": "electron .",
    "dev": "electron . --dev",
    "package": "electron-packager . 'Ulanzi Deck Open' --platform=darwin --arch=arm64 --out=dist --overwrite --icon=build/icon --app-bundle-id=com.edufalcao.ulanzideckopen --app-version=0.1.0 --prune=true --ignore='^/(dist|build/icon\\.iconset)'",
    "package:all": "electron-packager . 'Ulanzi Deck Open' --platform=darwin --arch=universal --out=dist --overwrite --icon=build/icon --app-bundle-id=com.edufalcao.ulanzideckopen --app-version=0.1.0 --prune=true --ignore='^/(dist|build/icon\\.iconset)'",
    "postpackage": "find dist -name electron.icns -exec cp build/icon.icns {} \\; ; find dist -maxdepth 2 -name \"*.app\" | while read app; do mkdir -p \"$app/Contents/Resources/bin\"; cp bin/hidseize \"$app/Contents/Resources/bin/\"; cp build/tray.png \"$app/Contents/Resources/tray.png\"; cp build/tray@2x.png \"$app/Contents/Resources/tray@2x.png\"; done"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "node-hid": "^3.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.1.0"
  }
}
