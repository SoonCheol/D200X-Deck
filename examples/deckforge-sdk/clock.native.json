{
  "apiVersion": 2,
  "id": "com.deckforge.native.example.clock",
  "name": "Digital Clock",
  "version": "1.0.0",
  "requiresDeckForge": ">=1.1.128",
  "permissions": [
    "display",
    "timer.tick"
  ],
  "actions": [
    {
      "id": "com.deckforge.native.example.clock.display",
      "name": "Clock",
      "controllers": [
        "Keypad"
      ],
      "states": 1,
      "tickIntervalMs": 1000,
      "script": "if(event.type==='appear'||event.type==='tick'){const d=new Date();api.setTitle([d.getHours(),d.getMinutes(),d.getSeconds()].map(v=>String(v).padStart(2,'0')).join(':'));}"
    }
  ]
}
